#!/bin/sh
# openbox 用 /bin/sh 跑这份脚本，不要写 bash 数组。
set -u

export LIBGL_ALWAYS_SOFTWARE=1
export DISPLAY="${DISPLAY:-:1}"

# 代理与起始页每次 Chromium 重启时重读（gpc-clipd 改完代理会杀掉 Chromium 触发重启）。
read_proxy() {
    PROXY_URL=""
    START_URL="https://chatgpt.com"
    # shellcheck source=/dev/null
    [ -f /config/.gpc-proxy ] && . /config/.gpc-proxy 2>/dev/null || true
    # 面板里按账号设置的代理优先于 env 默认；文件存在但为空 = 强制直连。
    if [ -f /config/.gpc-proxy-override ]; then
        PROXY_URL=$(head -n1 /config/.gpc-proxy-override | tr -d '[:space:]')
    fi
    START_URL="${START_URL:-https://chatgpt.com}"
}

# Hunch: gateway writes ENABLE_CDP=1 / TAB_SEATS=1 on the container, or
# /config/.gpc-cdp when the admin toggles 多人分屏. File wins so a toggle
# can flip Chrome without recreating the compose service. Default off.
read_cdp() {
    CDP_ON=0
    if [ "${ENABLE_CDP:-}" = "1" ] || [ "${TAB_SEATS:-}" = "1" ]; then
        CDP_ON=1
    fi
    if [ -f /config/.gpc-cdp ]; then
        FLAG=$(head -n1 /config/.gpc-cdp | tr -d '[:space:]')
        if [ "$FLAG" = "1" ]; then
            CDP_ON=1
        else
            CDP_ON=0
        fi
    fi
}

sync_cdp_fwd() {
    if [ "${CDP_ON}" = "1" ]; then
        if ! pgrep -f '/usr/local/bin/gpc-cdp-fwd' >/dev/null 2>&1; then
            python3 /usr/local/bin/gpc-cdp-fwd >/tmp/gpc-cdp-fwd.log 2>&1 &
        fi
    else
        pkill -f '/usr/local/bin/gpc-cdp-fwd' >/dev/null 2>&1 || true
    fi
}
read_proxy
read_cdp
sync_cdp_fwd

if command -v xsettingsd >/dev/null 2>&1; then
    cat > /config/.xsettingsd <<'EOF'
Xft/Antialias 1
Xft/Hinting 1
Xft/HintStyle "hintslight"
Xft/RGBA "rgb"
Xft/DPI 98304
Gtk/FontName "Noto Sans CJK SC 10"
EOF
    xsettingsd --config=/config/.xsettingsd 2>/dev/null &
fi

# 无任务栏：最小化 = 黑屏。每 2s 把不可见窗口拉回来。
# Extra tab-seat windows are parked at X <= -1000 by the gateway (CDP). Leave them there.
(
    while sleep 2; do
        all=$(xdotool search --name '.+' 2>/dev/null) || continue
        vis=$(xdotool search --onlyvisible --name '.+' 2>/dev/null)
        for w in ${all}; do
            geom=$(xdotool getwindowgeometry --shell "${w}" 2>/dev/null) || continue
            x=$(printf '%s\n' "${geom}" | awk -F= '/^X=/{print $2}')
            if [ -n "${x}" ] && [ "${x}" -le -1000 ] 2>/dev/null; then
                continue
            fi
            printf '%s\n' "${vis}" | grep -qx "${w}" || xdotool windowactivate "${w}" 2>/dev/null || true
        done
    done
) &

# 网关把本机剪贴板（含截图）送到这里，再 xclip + Ctrl+V。不依赖 CDP。
python3 /usr/local/bin/gpc-clipd >/tmp/gpc-clipd.log 2>&1 &

# 容器重建后 hostname 变了，旧 SingletonLock 会让 Chromium 秒退。
rm -f /config/chromium/SingletonLock /config/chromium/SingletonSocket /config/chromium/SingletonCookie

# Mark the last exit clean so admin VNC is not greeted by "Restore pages?".
python3 - <<'PY' >/dev/null 2>&1 || true
import json
from pathlib import Path
p = Path("/config/chromium/Default/Preferences")
try:
    data = json.loads(p.read_text()) if p.exists() else {}
except Exception:
    data = {}
if not isinstance(data, dict):
    data = {}
prof = data.setdefault("profile", {})
if isinstance(prof, dict):
    prof["exit_type"] = "Normal"
    prof["exited_cleanly"] = True
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(data, separators=(",", ":")))
PY

while true; do
    read_proxy
    read_cdp
    sync_cdp_fwd
    PROXY_FLAG=""
    if [ -n "${PROXY_URL:-}" ]; then
        PROXY_FLAG="--proxy-server=${PROXY_URL}"
        echo "[autostart] proxy-server=${PROXY_URL}"
    fi
    CDP_FLAGS=""
    WINDOW_ARG="--app=${START_URL}"
    if [ "${CDP_ON}" = "1" ]; then
        CDP_FLAGS="--remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 --remote-allow-origins=*"
        # Normal window: extra Target.createTarget windows must not end the process.
        # --app exits when its only window is closed or tab-ified.
        WINDOW_ARG="${START_URL}"
        echo "[autostart] cdp=on :9222 window=normal"
    else
        echo "[autostart] cdp=off"
    fi
    # No --kiosk. CDP-off uses --app for a single exclusive VNC window.
    # CDP-on uses a normal window so parked seat windows stay in-process.
    echo "[autostart] 启动 Chromium → ${START_URL}"
    /usr/bin/chromium \
        --no-sandbox \
        --test-type \
        --no-first-run \
        --no-default-browser-check \
        --hide-crash-restore-bubble \
        --disable-session-crashed-bubble \
        --start-fullscreen \
        --start-maximized \
        --password-store=basic \
        --disable-gpu \
        --force-device-scale-factor=1 \
        --disable-background-networking \
        --user-data-dir=/config/chromium \
        ${CDP_FLAGS} \
        "${WINDOW_ARG}" \
        ${PROXY_FLAG}
    code=$?
    echo "[autostart] Chromium 退出 code=${code}，2 秒后重启"
    sleep 2
done
