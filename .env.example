# 管理员凭据；密码必填，网关拒绝空密码启动
AUTH_USER=admin
AUTH_PASSWORD=

# 网关绑定地址与端口（唯一入口）。有公网 IP 的机器请绑内网地址（如 Tailscale IP）
BIND_ADDR=0.0.0.0
HTTP_PORT=36090

# 容器文件属主与时区
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 所有桌面的出口代理；回环地址会自动改写为 host.docker.internal
PROXY_URL=
# 按账号出口代理，优先于 PROXY_URL，留空回落
PROXY_URL_A=
PROXY_URL_B=

# 每个桌面打开的页面
START_URL=https://chatgpt.com

# 账号 id 列表，与 docker-compose.yml 的 desktop-* 服务一一对应
INSTANCES=a,b

# gateway 与桌面容器之间的内部 VNC 凭据（不对外暴露）
VNC_PASSWORD=gpc-internal
