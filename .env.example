# 可选：预设管理员（自动化部署用）。留空则首次访问网页时通过向导创建管理员
AUTH_USER=admin
AUTH_PASSWORD=

# 网关绑定地址与端口（唯一入口）。内网/VPN 绑对应地址；Cloudflare Tunnel 绑 127.0.0.1，避免面板以明文 HTTP 挂在公网网卡上
BIND_ADDR=0.0.0.0
HTTP_PORT=36090

# 容器文件属主与时区
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 所有桌面的出口代理；回环地址会自动改写为 host.docker.internal
PROXY_URL=
# 按账号出口代理，优先于 PROXY_URL，留空回落
PROXY_URL_A=
PROXY_URL_B=

# 每个桌面打开的页面
START_URL=https://chatgpt.com

# 内置桌面 id，与 compose 里的 desktop-a / desktop-b 对应。额外账号在面板里添加，不必改这项
INSTANCES=a,b

# 同一 ChatGPT 账号上同时打开的分屏标签页上限（不含第一个 VNC 席位）。1–8，默认 3
TAB_SEATS_MAX=3

# gateway 与桌面容器之间的内部 VNC 凭据（不对外暴露）
VNC_PASSWORD=gpc-internal
